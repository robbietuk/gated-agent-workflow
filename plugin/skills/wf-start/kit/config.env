# Agentic workflow settings for this repo (.workflow/config.env). Sourced by the stop hook (bash) and read by the wf-* skills.
# Set BUILD_CMD and TEST_CMD for your repo. Both run from the repo root via `bash -c`.
# Leave BUILD_CMD empty if your test command also builds.

BUILD_CMD=""          # e.g. "cmake --build build -j"   or "dotnet build"   or "npm run build"
TEST_CMD=""           # e.g. "ctest --test-dir build --output-on-failure"   or "dotnet test"   or "npm test"
CI_CMD=""             # optional: the local entry point to the repo's CI checks, e.g. "make ci".
                      # Empty: the skills find the checks in the Makefile / .github/workflows / other CI
                      # config (see .workflow/kit/ci-procedure.md) and cache them in .workflow/ci-checks.md.

# Iteration limits (see README "Limits"). Hitting a limit means escalate, never "one more try".
MAX_STOP_RUNS=5       # implement loop: build+test runs by the stop hook per slice, then /wf-escalate
MAX_REVIEW_ROUNDS=3   # slice-reviewer -> fix rounds per slice, then /wf-escalate
MAX_PR_FIX_ROUNDS=2   # branch review IMPORTANT fix -> re-run rounds, then /wf-escalate

# Scaling research and review to the size of the work (see .workflow/kit/scaling.md).
TIER_XS_LINES=50      # up to this many changed lines (and up to 2 files): tier XS
TIER_S_LINES=400      # up to this many (and up to 10 files): tier S
TIER_M_LINES=2000     # up to this many (and up to 40 files): tier M; above: tier L
MAX_REVIEW_AGENTS=12  # most reviewer subagents in one branch review (tier L)
MAX_RESEARCHERS=4     # most researcher subagents in one research run
